@model ImportCostPro.Core.Entities.ConfiguracionImpuestos

<h1>Configuración de Impuestos</h1>


<form asp-action="Index">

    <div class="mb-3">

        <label asp-for="PorcentajeITBIS"></label>

        <input asp-for="PorcentajeITBIS"
               class="form-control" />

        <span asp-validation-for="PorcentajeITBIS"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="PorcentajeTasaServicioAduanal"></label>

        <input asp-for="PorcentajeTasaServicioAduanal"
               class="form-control" />

        <span asp-validation-for="PorcentajeTasaServicioAduanal"
              class="text-danger"></span>

    </div>

    <button class="btn btn-success">
        Guardar
    </button>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}