@model ImportCostPro.Web.ViewModels.ProductoViewModel

<div class="mb-3">
    <label asp-for="Nombre" class="form-label"></label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CodigoReferencia" class="form-label"></label>
    <input asp-for="CodigoReferencia" class="form-control" />
    <span asp-validation-for="CodigoReferencia" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="PaisId" class="form-label"></label>
    <select asp-for="PaisId"
            asp-items="Model.Paises"
            class="form-select">
        <option value="">Seleccione...</option>
    </select>
</div>

<div class="mb-3">
    <label asp-for="CategoriaArancelariaId" class="form-label"></label>
    <select asp-for="CategoriaArancelariaId"
            asp-items="Model.Categorias"
            class="form-select">
        <option value="">Seleccione...</option>
    </select>
</div>

<div class="mb-3">
    <label asp-for="PesoUnitario" class="form-label"></label>
    <input asp-for="PesoUnitario" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="Largo" class="form-label"></label>
    <input asp-for="Largo" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="Ancho" class="form-label"></label>
    <input asp-for="Ancho" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="Alto" class="form-label"></label>
    <input asp-for="Alto" class="form-control" />
</div>

<div class="mb-3">
    <label asp-for="UnidadMedida" class="form-label"></label>
    <select asp-for="UnidadMedida" class="form-select">
        <option value="Unidad">Unidad</option>
        <option value="Caja">Caja</option>
        <option value="Paquete">Paquete</option>
        <option value="Docena">Docena</option>
        <option value="Galon">Galón</option>
        <option value="Metro">Metro</option>
    </select>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion"
              class="form-control"></textarea>
</div>

<div class="form-check mb-3">
    <input asp-for="Estado" class="form-check-input" />
    <label asp-for="Estado" class="form-check-label"></label>
</div>

<button type="submit" class="btn btn-success">
    Guardar
</button>

<a asp-action="Index" class="btn btn-secondary">
    Volver
</a>