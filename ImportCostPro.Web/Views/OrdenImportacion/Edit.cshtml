@model ImportCostPro.Web.ViewModels.OrdenImportacionViewModel
@{
    ViewData["Title"] = "Editar orden";
}

<h1>Editar orden de importación #@Model.Id</h1>

<form asp-action="Edit" class="card p-3" style="max-width: 40rem;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" type="date" class="form-control" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImportadorId" class="form-label"></label>
        <select asp-for="ImportadorId" asp-items="Model.Importadores" class="form-select">
            <option value="">Seleccione un importador</option>
        </select>
        <span asp-validation-for="ImportadorId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProveedorId" class="form-label"></label>
        <select asp-for="ProveedorId" asp-items="Model.Proveedores" class="form-select">
            <option value="">Seleccione un proveedor</option>
        </select>
        <span asp-validation-for="ProveedorId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MonedaId" class="form-label"></label>
        <select asp-for="MonedaId" asp-items="Model.Monedas" class="form-select">
            <option value="">Seleccione una moneda</option>
        </select>
        <span asp-validation-for="MonedaId" class="text-danger"></span>
    </div>

    <p class="text-muted small">El estado de la orden cambia solo con el cálculo oficial, el cierre o la cancelación.</p>

    <div>
        <button class="btn btn-success">Guardar cambios</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Volver atrás</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
