@using ImportCostPro.Core.Enums
@model List<ImportCostPro.Core.Entities.OrdenImportacion>
@{
    ViewData["Title"] = "Órdenes de importación";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Órdenes de importación</h1>
    <a asp-action="Create" class="btn btn-primary">Crear orden</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Fecha</th>
            <th>Importador</th>
            <th>Proveedor</th>
            <th>Moneda</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var badge = item.Estado switch
            {
                EstadoOrden.Abierta => "bg-primary",
                EstadoOrden.Calculada => "bg-success",
                EstadoOrden.Cerrada => "bg-dark",
                _ => "bg-secondary"
            };
            <tr>
                <td>@item.Id</td>
                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@item.Importador?.Nombre</td>
                <td>@item.Proveedor?.Nombre</td>
                <td>@item.Moneda?.CodigoISO</td>
                <td><span class="badge @badge">@item.Estado</span></td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Detalle</a>
                    @if (item.Estado == EstadoOrden.Abierta)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    }
                    else if (item.Estado != EstadoOrden.Cancelada)
                    {
                        <a asp-controller="LandedCost" asp-action="Oficial" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm">Cálculo oficial</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
