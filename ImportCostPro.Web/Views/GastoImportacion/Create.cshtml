@using ImportCostPro.Core.Enums;

@model ImportCostPro.Web.ViewModels.GastoImportacionViewModel

<h1>Registrar Gasto</h1>

<form asp-action="Create">

    <div asp-validation-summary="All"
         class="text-danger">
    </div>

    <div class="mb-3">
        <label asp-for="OrdenImportacionId"></label>
        <select asp-for="OrdenImportacionId"
                asp-items="Model.Ordenes"
                class="form-select">
            <option value="">
                Seleccione una orden
            </option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="TipoGasto"></label>
        <select asp-for="TipoGasto"
                asp-items="Html.GetEnumSelectList<TipoGasto>()"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Monto"></label>
        <input asp-for="Monto"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MonedaId"></label>
        <select asp-for="MonedaId"
                asp-items="Model.Monedas"
                class="form-select">
            <option value="">
                Seleccione una moneda
            </option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="MetodoDistribucion"></label>
        <select asp-for="MetodoDistribucion"
                asp-items="Html.GetEnumSelectList<MetodoDistribucion>()"
                class="form-select">
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Fecha"></label>
        <input asp-for="Fecha"
               type="date"
               class="form-control" />
    </div>

    <button class="btn btn-success">
        Guardar
    </button>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}