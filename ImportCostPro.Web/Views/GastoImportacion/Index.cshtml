@model List<ImportCostPro.Core.Entities.GastoImportacion>

<h1>Gastos de Importación</h1>

<a asp-action="Create"
   class="btn btn-primary mb-3">
    Nuevo Gasto
</a>

<table class="table table-striped">

    <thead>
        <tr>
            <th>Orden</th>
            <th>Tipo</th>
            <th>Monto</th>
            <th>Moneda</th>
            <th>Fecha</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.OrdenImportacionId</td>

                <td>@item.TipoGasto</td>

                <td>@item.Monto</td>

                <td>@item.Moneda?.Descripcion</td>

                <td>@item.Fecha.ToShortDateString()</td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>