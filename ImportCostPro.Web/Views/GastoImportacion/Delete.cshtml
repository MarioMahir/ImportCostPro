@model ImportCostPro.Core.Entities.GastoImportacion

<h3>
    ¿Está seguro que desea eliminar este gasto?
</h3>

<form asp-action="DeleteConfirmed">

    <input type="hidden"
           asp-for="Id" />

    <button class="btn btn-danger">
        Eliminar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>