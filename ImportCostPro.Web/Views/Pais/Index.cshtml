@model List<ImportCostPro.Core.Entities.Pais>

<h1 class="mb-4">Países</h1>

<a asp-action="Create" class="btn btn-primary mb-3">
    Nuevo País
</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Código ISO</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var pais in Model)
        {
            <tr>
                <td>@pais.Nombre</td>
                <td>@pais.CodigoISO</td>
                <td>
                    @(pais.Estado ? "Activo" : "Inactivo")
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@pais.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@pais.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>