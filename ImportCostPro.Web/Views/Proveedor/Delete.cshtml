@model ImportCostPro.Core.Entities.Proveedor

@{
    ViewData["Title"] = "Eliminar Proveedor";
}

<h3>
    ¿Está seguro que desea eliminar este proveedor?
</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">País</dt>
    <dd class="col-sm-9">@Model.Pais?.Nombre</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@Model.Telefono</dd>

</dl>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Aceptar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>