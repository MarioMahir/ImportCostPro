@model IEnumerable<ImportCostPro.Core.Entities.TasaCambio>

@{
    ViewData["Title"] = "Tasas de Cambio";
}

<h2>Tasas de Cambio</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Registrar tasa
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Moneda Origen</th>
            <th>Moneda Destino</th>
            <th>Tasa</th>
            <th>Fecha Vigencia</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MonedaOrigen?.Descripcion</td>
                <td>@item.MonedaDestino?.Descripcion</td>
                <td>@item.ValorTasa</td>
                <td>@item.FechaVigencia.ToShortDateString()</td>
                <td>
                    @(item.Estado ? "Activa" : "Inactiva")
                </td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>